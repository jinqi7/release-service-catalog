---
# This is a template for tenant secrets for the collectors-multi-200 test
#
# To use this template:
# 1. Copy this file to tenant-secrets.yaml
# 2. Fill in the actual secret values (CHANGE_ME placeholders)
# 3. Encrypt using: ansible-vault encrypt vault/tenant-secrets.yaml --vault-password-file <path-to-vault-password-file>
#
# Required secrets:
# - pipelines-as-code-secret: GitHub token for Pipelines as Code
# - jira-collectors-secret: JIRA API token for collector integration
#

apiVersion: v1
kind: Secret
metadata:
  name: pipelines-as-code-secret-${component_name}
  labels:
    originating-tool: "${originating_tool}"
type: kubernetes.io/basic-auth
stringData:
  password: "CHANGE_ME_GITHUB_TOKEN"
  username: "git"
  provider.token: "CHANGE_ME_GITHUB_TOKEN"
---
apiVersion: v1
kind: Secret
metadata:
  name: jira-collectors-secret-${component_name}
  labels:
    originating-tool: "${originating_tool}"
type: Opaque
stringData:
  token: "CHANGE_ME_JIRA_API_TOKEN"
