---
# This is a template for managed secrets for the collectors-multi-200 test
#
# To use this template:
# 1. Copy this file to managed-secrets.yaml
# 2. Fill in the actual secret values (CHANGE_ME placeholders)
# 3. Encrypt using: ansible-vault encrypt vault/managed-secrets.yaml --vault-password-file <path-to-vault-password-file>
#
# Required secrets:
# - push secret: Container registry push credentials
# - pyxis secret: Pyxis API credentials
# - atlas secrets: Atlas SBOM service credentials
# - cosign secret: Image signing credentials
#

apiVersion: v1
kind: Secret
metadata:
  name: push-${component_name}
  labels:
    originating-tool: "${originating_tool}"
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "CHANGE_ME_BASE64_ENCODED_DOCKER_CONFIG"
---
apiVersion: v1
kind: Secret
metadata:
  name: pyxis-${component_name}
  labels:
    originating-tool: "${originating_tool}"
type: Opaque
stringData:
  cert: "CHANGE_ME_PYXIS_CERT"
  key: "CHANGE_ME_PYXIS_KEY"
---
apiVersion: v1
kind: Secret
metadata:
  name: atlas-staging-sso-secret-${component_name}
  labels:
    originating-tool: "${originating_tool}"
type: Opaque
stringData:
  client_id: "CHANGE_ME_ATLAS_CLIENT_ID"
  client_secret: "CHANGE_ME_ATLAS_CLIENT_SECRET"
---
apiVersion: v1
kind: Secret
metadata:
  name: atlas-retry-s3-staging-secret-${component_name}
  labels:
    originating-tool: "${originating_tool}"
type: Opaque
stringData:
  aws_access_key_id: "CHANGE_ME_AWS_ACCESS_KEY_ID"
  aws_secret_access_key: "CHANGE_ME_AWS_SECRET_ACCESS_KEY"
  bucket: "CHANGE_ME_S3_BUCKET_NAME"
  region: "us-east-1"
---
apiVersion: v1
kind: Secret
metadata:
  name: konflux-cosign-signing-stage-${component_name}
  labels:
    originating-tool: "${originating_tool}"
type: Opaque
stringData:
  cosign.key: "CHANGE_ME_COSIGN_PRIVATE_KEY"
  cosign.password: "CHANGE_ME_COSIGN_PASSWORD"
  cosign.pub: "CHANGE_ME_COSIGN_PUBLIC_KEY"
---
apiVersion: v1
kind: Secret
metadata:
  name: konflux-ci-konflux-release-trusted-artifacts-pull-secret-${component_name}
  labels:
    originating-tool: "${originating_tool}"
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: "CHANGE_ME_BASE64_ENCODED_DOCKER_CONFIG"
