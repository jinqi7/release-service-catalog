#!/usr/bin/env bash
#
# Test configuration for collectors-multi-200 test suite
# This test suite validates the release pipeline with 200+ components
# to ensure scalability and proper handling of large-scale releases.
#
uuid=${uuid:-"$(openssl rand -hex 4)"}
# make sure uuid is 8 chars long
uuid="${uuid:0:8}"
#uuid="d9666b7c"
export originating_tool="collector-multi-200-e2e-test"

# Namespaces
export tenant_namespace=dev-release-team-tenant
#
## Since this is a test that requires internal services,
## this name should not change.
#
export managed_namespace=managed-release-team-tenant

export application_name=collector-multi-${uuid}
export component_type=collector-multi
export component_name=${component_type}-comp1-${uuid}
export component_branch=${component_name}
## do not change this. it is a known branch created by Konflux
export appstudio_component_branch="appstudio-${component_name}"

export component_github_org=hacbs-release-tests
export component_base_branch=collectors-base
export component_repo_name=${component_github_org}/${component_name}
#export component_repo2_name=${component_github_org}/${component_type}-repo2-${uuid}
export component_base_repo_name=${component_github_org}/e2e-base
export component_git_url=https://github.com/$component_repo_name

# Total number of components to test
export TOTAL_COMPONENTS=200

# Component retry configuration
export MAX_COMPONENT_RETRIES=5
export RETRY_DELAY_SECONDS=30

# PipelineRun retry configuration
export MAX_PLR_RETRIES=3
export PLR_RETRY_DELAY_SECONDS=60

# Timeout configurations (in seconds) - increased for 150-component scale
export COMPONENT_INIT_TIMEOUT=1800       # 30 minutes per component (180 attempts)
export PLR_APPEAR_TIMEOUT=1200           # 20 minutes
export PLR_COMPLETE_TIMEOUT=3600         # 60 minutes per PipelineRun
export RELEASE_TIMEOUT=7200              # 120 minutes for release completion

# Parallel execution settings
export MAX_PARALLEL_BUILDS=20           # Maximum concurrent component builds
export MAX_PARALLEL_RELEASES=5          # Maximum concurrent releases

# GitHub API rate limit settings
# Smaller batch sizes and longer delays to avoid hitting rate limits (5000 req/hour)
export GITHUB_BATCH_SIZE=10              # Number of parallel GitHub operations per batch
export GITHUB_BATCH_DELAY=0            # Delay in seconds between batches

# Component creation batching (to avoid overwhelming the system)
export COMPONENT_BATCH_1_SIZE=100       # Number of components in first batch
export COMPONENT_BATCH_DELAY=600        # Delay in seconds between component batches (5 minutes)

# Service accounts
export tenant_collector_sa_name=collector-multi200-sa-${uuid}
export tenant_sa_name=collector-multi200-tenant-sa-${uuid}
export release_plan_name=collector-multi200-rp-${uuid}

export managed_sa_name=collector-multi200-sa-${uuid}
export release_plan_admission_name=collector-multi200-rpa-${uuid}

# Dynamically generate component configurations for components 2 through TOTAL_COMPONENTS
# Component 1 is already defined above as the primary component
# All additional components will use branches on the same repo to simplify PAC configuration

echo "Generating configuration for ${TOTAL_COMPONENTS} components..."

for i in $(seq 2 ${TOTAL_COMPONENTS}); do
    eval "export component${i}_name=${component_type}-comp${i}-${uuid}"
    eval "export component${i}_branch=\${component${i}_name}"
    if [ $i -le 200 ]; then
        eval "export component${i}_repo_name=${component_repo_name}"
    else
        eval "export component${i}_repo_name=${component_repo2_name}"
    fi
    eval "export component${i}_git_url=https://github.com/\${component${i}_repo_name}"
done

echo "✅ Configuration generated for ${TOTAL_COMPONENTS} components"
